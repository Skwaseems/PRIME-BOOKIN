# Copy to .env and adjust.
PORT=5000

# Leave empty in development to use the embedded MongoDB (data kept in server/.data).
# For production use a real MongoDB / Atlas connection string.
MONGO_URI=

# Use a long random string in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# Seeded admin account (created on first start if no admin exists).
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin123

# WhatsApp support number shown in the app (country code, no +).
SUPPORT_WHATSAPP=917768817510
