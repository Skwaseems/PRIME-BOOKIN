{
    // Press F5 (Run → Start Debugging) and pick one of these.
    // Both start the Next.js dev server first, then open the app in the browser.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run app (localhost:3000)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "serverReadyAction": {
                "pattern": "- Local:.+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Run app for mobile (same Wi-Fi)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev:mobile",
            "serverReadyAction": {
                "pattern": "- Local:.+(https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
